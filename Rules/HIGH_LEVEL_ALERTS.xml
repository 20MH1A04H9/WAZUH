                                                                                                        <!-- Windows Defender rules -->
 
 


<rule id="100121" level="12">
<if_group>windows</if_group>
<field name="win.system.eventID">^2082$</field>
<field name="win.eventdata.settingValueString">^No$</field>
<description>Windows Defender Firewall was DISABLED</description>
<group>firewall_disabled,</group>
</rule>


<rule id="100122" level="5">
<if_group>windows</if_group>
<field name="win.system.eventID">^2082$</field>
<field name="win.eventdata.settingValueString">^Yes$</field>
<description>Windows Defender Firewall was ENABLED</description>
<group>firewall_enabled,</group>
</rule>





 

                                                                                                     <!-- wmi -->



  <rule id="100123" level="12">

    <field name="win.system.channel">^Microsoft-Windows-WMI-Activity/Operational$</field>

    <field name="win.system.eventID">^5857$|^5858$|^5859$|^5860$|^5861$</field>

    <description>Windows Management Instrumentation (WMI) remote execution detected.</description>

    <mitre>
      <id>T1047</id>
    </mitre>

    <group>wmi,lateral_movement,execution,</group>

  </rule>

                                                                                                     
 
 
 
<rule id="100124" level="14">

    <if_matched_sid timeframe="300">100237</if_matched_sid>

    <if_sid>100112</if_sid>

    <same_field>agent.id</same_field>

    <description>File copied to ADMIN$ followed by PsExec service creation. Possible lateral movement.</description>

    <mitre>
        <id>T1021.002</id>
        <id>T1569.002</id>
    </mitre>

    <group>correlation,lateral_movement,psexec,</group>

</rule>                                                                                                    
                                                                                                   
 
                                                                                                          <!-- PsExec\_RemoteLogin -->

 
 
                                                                                                      
<rule id="100125" level="14">

    <if_matched_sid timeframe="300">100237</if_matched_sid>

    <if_sid>92651</if_sid>

    <same_field>agent.id</same_field>

    <description>SMB Admin Share access, PsExec service creation and remote logon detected. High-confidence PsExec lateral movement.</description>

    <mitre>
        <id>T1021.002</id>
        <id>T1569.002</id>
    </mitre>

    <group>correlation,lateral_movement,psexec,critical,</group>

</rule>                                                                                                                                                                                                                 
 
                                                                                                          <!-- Rundll32 executed -->


    <rule id="100126" level="0">

        <if_sid>60103</if_sid>

        <field name="win.system.eventID">^4688$</field>

        <field name="win.eventdata.newProcessName" type="pcre2">
(?i)\\rundll32\.exe$
        </field>

        <description>Rundll32 executed.</description>

        <mitre>
            <id>T1218.011</id>
        </mitre>

        <group>execution,lolbin,rundll32,</group>

    </rule>
 
                                                                                                        <!-- Suspicious Rundll32 execution -->
 
    <rule id="100127" level="12">

        <if_sid>100126</if_sid>

        <field name="win.eventdata.commandLine" type="pcre2">
(?i)(temp|appdata|downloads|public|\\\\)
        </field>

        <description>Suspicious Rundll32 execution from a non-standard location.</description>

        <mitre>
            <id>T1218.011</id>
        </mitre>

        <group>execution,lolbin,rundll32,suspicious,</group>

    </rule>


</group>                                                                                                        
 
 
 
 
 
 
 
