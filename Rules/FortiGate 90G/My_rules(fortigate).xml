<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>


<group name="fortigate,">

  <rule id="101500" level="7">
    <if_sid>81618</if_sid>
    <field name="srcintfrole">^wan$</field>
    <field name="policyid">^0$</field>
    <description>Fortigate: WAN - $(srcip) [$(srccountry)] action=$(action) service=$(service)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>fortigate_wan_local_in,</group>
  </rule>


  <rule id="101501" level="7">
    <if_group>fortigate</if_group>
    <action>ssl-login-fail</action>
    <description>Fortigate: SSL VPN login failure - user=$(dstuser) from $(remip) reason=$(reason)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>fortigate_vpn_login_fail,authentication_failed,</group>
  </rule>

  <rule id="101502" level="10" frequency="5" timeframe="120">
    <if_matched_sid>101501</if_matched_sid>
    <same_field>remip</same_field>
    <description>Fortigate: Possible SSL VPN brute force from $(remip) - 5 failed logins in 120s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>fortigate_vpn_bruteforce,authentication_failures,</group>
  </rule>


  <rule id="101503" level="3">
    <if_group>fortigate</if_group>
    <action>tunnel-down</action>
    <description>Fortigate: SSL VPN tunnel down - user=$(dstuser) from $(remip) reason=$(reason)</description>
    <group>fortigate_vpn_logout,</group>
  </rule>


  <rule id="101504" level="3">
    <if_group>fortigate</if_group>
    <action>tunnel-up</action>
    <description>Fortigate: SSL VPN login success - user=$(dstuser) from $(remip)</description>
    <group>fortigate_vpn_login_success,</group>
  </rule>


  <rule id="101505" level="5" timeframe="3600">
    <if_matched_sid>101504</if_matched_sid>
    <if_sid>81618</if_sid>
    <same_field>dstuser</same_field>
    <description>Fortigate: LAN traffic from VPN session - user=$(dstuser) src=$(srcip) dst=$(dstip) service=$(service)</description>
    <group>fortigate_vpn_session_traffic,</group>
  </rule>

  <rule id="101506" level="0">
    <if_sid>81618</if_sid>
    <regex type="pcre2">action="deny"</regex>
    <description>Fortigate - deny suppressed (noise)</description>
    <group>fortigate_deny_suppressed,</group>
  </rule>

</group>
